# -*- coding: utf-8 -*-
"""辰心知阮 · 公河提交前秘密拦截钩子(pre-commit)
================================================================
为什么有它(阿境 T26-3):公河是匿名可读的永久历史,只追加不覆盖意味着
一次脱敏漏拦就永久留在提交历史里。所以在"进 git"这道门再卡一道:
对本次 staged 的文本内容做固定形状正则 + 通用高熵扫描,命中即阻断提交。
它是无状态纯代码规则,不调用任何模型,不联网。
安装:  cp tools/githooks/pre-commit .git/hooks/pre-commit && chmod +x
       (或 bash tools/githooks/install.sh)
本文件只放"通用形状",绝不写死任何自家真实 IP/端口/桶名/口令——
那些专属脱敏词由本机环境变量 RIVER_REDACT 在握笔流程里另管,不进公开仓。
作者:豆阿辰 · 密钥 790511 🐇
"""
import math
import re
import subprocess
import sys
from collections import Counter

PATTERNS = [
    (re.compile(r"AKLT[A-Za-z0-9]{8,}"), "火山AK"),
    (re.compile(r"gh[pousr]_[A-Za-z0-9]{20,}"), "GitHub令牌"),
    (re.compile(r"sk-[A-Za-z0-9_.\-]{16,}"), "sk-密钥"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"), "私钥"),
    (re.compile(r"(?:password|passwd|secret|token)[\"']?\s*[=:：]\s*[\"']?(?=[A-Za-z0-9_.\-]{8,})(?=[A-Za-z0-9_.\-]*\d)[A-Za-z0-9][A-Za-z0-9_.\-]{7,}", re.I),
     "口令样态(=后8位以上且含数字的机器密钥;中文/占位/os.environ代码不拦)"),
]


def entropy(s):
    n = len(s)
    return -sum((c / n) * math.log2(c / n) for c in Counter(s).values())


def hit_in(text):
    for pat, name in PATTERNS:
        m = pat.search(text)
        if m:
            return f"{name}: {m.group(0)[:10]}…"
    for tok in re.findall(r"[A-Za-z0-9+=\-_.]{32,}", text):  # 不含/:路径与URL靠斜杠切段,免误伤
        core = tok.strip("-_=")
        if len(core) < 32:
            continue
        mix = (any(c.isupper() for c in core)
               and any(c.islower() for c in core)
               and any(c.isdigit() for c in core))
        b64 = any(c in "+/=" for c in core)
        if (mix or b64) and entropy(core) >= 4.2:
            return f"高熵密钥样态: {core[:6]}…"
    return None


def staged_files():
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=AM"],
        capture_output=True, text=True).stdout
    return [f for f in out.splitlines() if f]


def main():
    bad = []
    for f in staged_files():
        try:
            data = subprocess.run(
                ["git", "show", f":{f}"], capture_output=True).stdout
            text = data.decode("utf-8", errors="ignore")
        except Exception:
            continue
        hit = hit_in(text)
        if hit:
            bad.append((f, hit))
    if bad:
        sys.stderr.write("\n✘ pre-commit 拦下疑似秘密,公河不许带凭证,请脱敏后再提交:\n")
        for f, hit in bad:
            sys.stderr.write(f"  - {f}: {hit}\n")
        sys.stderr.write("(确属误报可 git commit --no-verify 跳过,但请先想清楚)\n")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
