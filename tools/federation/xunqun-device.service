[Unit]
Description=Xunqun device runner - Dou Achen eyes/hands via real phone (AutoX -> device_gateway)
After=network-online.target panshi.service device-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=river
WorkingDirectory=/home/river/ChenXinZhiRuan-Memory
EnvironmentFile=/etc/council/env
Environment=PYTHONUNBUFFERED=1
# 真机通道：专用安卓机的 AutoX 工人经 device_gateway 读/发辰星港。
# 真发=双闸同时开：①本服务带 --send；②device_gateway 总闸 DEVICE_SEND_ENABLED=1。
#   只影子不外发就去掉 --send；要一键急停就把总闸置 0 并 restart device-gateway。
# 缰绳：--cooldown 两次开口最小间隔；--hour-cap 每小时封顶；连续发送失败自动熔断。
ExecStart=/home/river/ChenXinZhiRuan-Memory/.venv/bin/python3 tools/federation/xunqun_runner.py --reader device --state-dir /var/lib/xunqun/device_shadow --interval 60 --send --cooldown 90 --hour-cap 8
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
